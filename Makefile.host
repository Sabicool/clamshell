# Desktop build of the portable core + test CLI (macOS/Linux).
#   make -f Makefile.host            -> build/host/anki3ds-cli
#   make -f Makefile.host test       -> differential test against real Anki
CXX ?= clang++
CC ?= clang
BUILD := build/host
# -ffp-contract=off: never fuse float multiply-adds; Rust doesn't, and the
# scheduler must round exactly like desktop Anki.
INCLUDES := -Icore -Icore/render -Iapp -Ithird_party -Ithird_party/sqlite -Ithird_party/zstd \
	-Ithird_party/litehtml/include -Ithird_party/litehtml/include/litehtml \
	-Ithird_party/litehtml/src/gumbo/include -Ithird_party/litehtml/src/gumbo/include/gumbo
CXXFLAGS := -std=c++17 -O2 -g -ffp-contract=off -Wall -Wno-unused-function $(INCLUDES)
CFLAGS := -O2 -ffp-contract=off -DSQLITE_OMIT_LOAD_EXTENSION -Ithird_party/zstd

CORE_SRC := $(wildcard core/*.cpp core/render/*.cpp)
CORE_OBJ := $(patsubst core/%.cpp,$(BUILD)/core/%.o,$(CORE_SRC))
LH_SRC := $(wildcard third_party/litehtml/src/*.cpp)
LH_OBJ := $(patsubst third_party/litehtml/src/%.cpp,$(BUILD)/litehtml/%.o,$(LH_SRC))
GUMBO_SRC := $(wildcard third_party/litehtml/src/gumbo/*.c)
GUMBO_OBJ := $(patsubst third_party/litehtml/src/gumbo/%.c,$(BUILD)/gumbo/%.o,$(GUMBO_SRC))
ZSTD_SRC := $(wildcard third_party/zstd/common/*.c third_party/zstd/compress/*.c third_party/zstd/decompress/*.c)
ZSTD_OBJ := $(patsubst third_party/zstd/%.c,$(BUILD)/zstd/%.o,$(ZSTD_SRC))

all: $(BUILD)/anki3ds-cli $(BUILD)/anki3ds-sim

APP_SRC := $(wildcard app/*.cpp)
APP_OBJ := $(patsubst app/%.cpp,$(BUILD)/app/%.o,$(APP_SRC))

$(BUILD)/app/%.o: app/%.cpp $(wildcard app/*.h core/*.h core/render/*.h)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD)/core/%.o: core/%.cpp $(wildcard core/*.h core/render/*.h)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD)/litehtml/%.o: third_party/litehtml/src/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -w -c $< -o $@

$(BUILD)/gumbo/%.o: third_party/litehtml/src/gumbo/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -Ithird_party/litehtml/src/gumbo/include -Ithird_party/litehtml/src/gumbo/include/gumbo -w -c $< -o $@

$(BUILD)/zstd/%.o: third_party/zstd/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -DZSTD_DISABLE_ASM -c $< -o $@

$(BUILD)/sqlite3.o: third_party/sqlite/sqlite3.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/host/%.o: host/%.cpp $(wildcard core/*.h)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD)/anki3ds-cli: $(CORE_OBJ) $(LH_OBJ) $(GUMBO_OBJ) $(ZSTD_OBJ) $(BUILD)/sqlite3.o $(BUILD)/host/cli.o $(BUILD)/host/http_curl.o
	$(CXX) $^ -lcurl -o $@

$(BUILD)/anki3ds-sim: $(APP_OBJ) $(CORE_OBJ) $(LH_OBJ) $(GUMBO_OBJ) $(ZSTD_OBJ) $(BUILD)/sqlite3.o $(BUILD)/host/sim.o $(BUILD)/host/http_curl.o
	$(CXX) $^ -lcurl -o $@

# The 3DS network stack (mbedTLS + sockets) built for the desktop, for testing.
MBED_SRC := $(filter-out %/net_sockets.c %/timing.c,$(wildcard third_party/mbedtls/library/*.c))
MBED_OBJ := $(patsubst third_party/mbedtls/library/%.c,$(BUILD)/mbedtls/%.o,$(MBED_SRC))
MBED_FLAGS := -Ithird_party/mbedtls/include -I3ds/source -Ihost/shim -DMBEDTLS_USER_CONFIG_FILE='"mbedtls_3ds_config.h"'
$(BUILD)/mbedtls/%.o: third_party/mbedtls/library/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(MBED_FLAGS) -w -c $< -o $@
$(BUILD)/host/http_3ds.o: 3ds/source/http_3ds.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(MBED_FLAGS) -DANKI3DS_HOST_TEST -c $< -o $@
$(BUILD)/anki3ds-cli-3dsnet: $(CORE_OBJ) $(LH_OBJ) $(GUMBO_OBJ) $(ZSTD_OBJ) $(MBED_OBJ) $(BUILD)/sqlite3.o $(BUILD)/host/cli.o $(BUILD)/host/http_3ds.o
	$(CXX) $^ -o $@

test: all
	tools/.venv/bin/python tools/difftest.py

clean:
	rm -rf $(BUILD)

.PHONY: all test clean
